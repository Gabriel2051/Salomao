# SALOMÃO — exemplo de variáveis de ambiente (NUNCA commite valores reais).
# Copie para .env (ou exporte no shell) e ajuste.

# JDBC do PostgreSQL (banco "salomao" — nesta máquina, cluster 17 na porta 5433)
DATABASE_URL=jdbc:postgresql://localhost:5433/salomao
DATABASE_USER=salomao
DATABASE_PASSWORD=troque-esta-senha

# Segredo da aplicação (mín. 32 caracteres aleatórios em produção)
AUTH_SECRET=gere-um-valor-aleatorio-longo-com-ao-menos-32-caracteres

# URL pública da aplicação
APP_URL=http://localhost:8080

# Porta (opcional)
PORT=8080

# Cookie seguro — true SOMENTE com HTTPS em produção
APP_SECURE_COOKIE=false
